# Copy to .env.local and fill in. Never commit real values.
# Anything starting with NEXT_PUBLIC_ is sent to the browser — public by design.

# Supabase (staging project for local dev; Singapore region)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=
# Only used by the RLS test that proves the browser key cannot read the waitlist.
SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile. These are Cloudflare's official "always passes" test keys —
# replace with real keys from the Cloudflare dashboard for staging/production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
