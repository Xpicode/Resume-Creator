# Copy to .env.local and fill in. Never commit real values.
# Anything starting with NEXT_PUBLIC_ is sent to the browser — public by design.

# Supabase. Local: run `npx supabase start` and copy API_URL / PUBLISHABLE_KEY / SECRET_KEY.
# Staging/production: project settings → API (Singapore region).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server only. Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile. These are Cloudflare's official "always passes" test keys —
# replace with real keys for staging/production, and also enable Turnstile in
# Supabase → Authentication → Attack Protection (it checks the token on sign-up, login, guest start and reset).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Signs the short-lived cookie that moves a guest's resume into the account they log into.
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
MERGE_TICKET_SECRET=

# Protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token). 16+ random characters.
CRON_SECRET=

# Claude API key for AI features (server only). Without it the AI buttons say "not available".
# Create one at https://platform.claude.com — set a monthly spend limit there.
ANTHROPIC_API_KEY=

# PayMongo (Job Hunt Pass). Without both, the Billing page says "Payments open soon".
# Developers → API keys (use sk_test_… until the merchant account is live).
# Developers → Webhooks: endpoint https://<your-domain>/api/webhooks/paymongo, events
# checkout_session.payment.paid, payment.refunded, payment.refund.updated → copy its secret (whsk_…).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Public site URL for the sitemap, share previews and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry error tracking (optional; off when empty). Request bodies, cookies and user details are stripped.
NEXT_PUBLIC_SENTRY_DSN=
